{
  "name": "api-tienda-comics",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de autores y cómics — Programación Orientada a la Web",
  "author": "Miguel Ángel Ossa",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
